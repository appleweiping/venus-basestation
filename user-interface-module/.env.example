VENUS_MQTT_HOST=mqtt.ics.ele.tue.nl
VENUS_MQTT_USERNAME=robot_15_1
VENUS_MQTT_PASSWORD=
# Telemetry topic. Leave unset to derive it from the username
# (robot_15_1 -> /pynqbridge/15/send, plus a full-username fallback
# subscription for older test scripts). Set this only to override.
# VENUS_MQTT_TOPICS=/pynqbridge/15/send
# Robot command uplink topic. Leave unset: it is derived from the username
# (robot_15_1 -> /pynqbridge/15/recv), which prevents sending an
# E-STOP to the wrong board after a partial credentials edit.
# VENUS_MQTT_COMMAND_TOPIC=/pynqbridge/15/recv
# Show MULTIPLE robots at once (the broker locks each credential to its own
# board, so one connection per account). Comma-separated user:password;
# commands target the account matching VENUS_MQTT_USERNAME above. Leave unset
# for a single robot.
# VENUS_MQTT_ACCOUNTS=robot_43_1:pass43,robot_15_1:pass15
