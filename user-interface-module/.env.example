VENUS_MQTT_HOST=mqtt.ics.ele.tue.nl
VENUS_MQTT_USERNAME=robot_15_1
VENUS_MQTT_PASSWORD=
# Telemetry topic. Leave unset to derive it from the username
# (robot_15_1 -> /pynqbridge/robot_15_1/send). The pynqbridge id is the full
# username, matching Team 28's robot publisher — set this only to override.
# VENUS_MQTT_TOPICS=/pynqbridge/robot_15_1/send
# Robot command uplink topic. Leave unset: it is derived from the username
# (robot_15_1 -> /pynqbridge/robot_15_1/recv), which prevents sending an
# E-STOP to the wrong board after a partial credentials edit.
# VENUS_MQTT_COMMAND_TOPIC=/pynqbridge/robot_15_1/recv
