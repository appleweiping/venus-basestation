VENUS_MQTT_HOST=mqtt.ics.ele.tue.nl
VENUS_MQTT_USERNAME=robot_15_1
VENUS_MQTT_PASSWORD=
VENUS_MQTT_TOPICS=/pynqbridge/15/send
# Robot command uplink topic. Leave unset: it is derived from the username
# (robot_15_1 -> /pynqbridge/15/recv), which prevents sending an E-STOP to
# the wrong board after a partial credentials edit.
# VENUS_MQTT_COMMAND_TOPIC=/pynqbridge/15/recv
